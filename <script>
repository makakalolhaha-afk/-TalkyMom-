    {en:'father', ru:'папа', exEN:'My father works.', exRU:'Мой папа работает.'},
    {en:'sister', ru:'сестра', exEN:'I have a sister.', exRU:'У меня есть сестра.'},
    {en:'brother', ru:'брат', exEN:'I have a brother.', exRU:'У меня есть брат.'}
  ]}
];

// --- Kids ---
const kidsIdeas = [
  {en:'Sing a song with gestures', ru:'Пой песенку с движениями'},
  {en:'Read a colorful picture book', ru:'Читай яркую книжку с картинками'}
];

// --- Library ---
const library = [
  {title:'Paw Patrol', link:'https://www.youtube.com/watch?v=UDgjJ9XzgHk', age:'1–3', desc:'Team of rescue dogs.'},
  {title:'Peppa Pig', link:'https://www.youtube.com/watch?v=AqY_I8bWjTk', age:'2-3', desc:'Simple stories for toddlers.'}
